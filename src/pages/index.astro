---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const ridge = String.raw`        /\                      /\
       /  \      /\            /  \    /\
      /    \    /  \  /\      /    \  /  \
  ___/      \__/    \/  \____/      \/    \___`;
const email = 'luis113654@gmail.com';
const phone = '910763682';

// Real commits from the NoreTel CRM repository (private code, public messages).
const commits = [
  ['05c91e0', '2026-09-27', 'fix(network): restrict router SSH console to authorized users'],
  ['8f7d525', '2026-09-27', 'fix(auth): rate-limit login attempts'],
  ['6aa0d06', '2026-09-27', 'perf(billing): remove N+1 queries in invoice and payment screens'],
  ['b6a9a7a', '2026-09-27', 'fix(security): stop exposing exception details to users'],
  ['fb240bf', '2026-07-21', 'fix(billing): add guarded yape queue reset'],
  ['9fd3fff', '2026-07-21', 'feat(billing): review late yape captures manually'],
  ['51183c3', '2026-07-07', 'feat(billing): add thermal payment receipt sending via whatsapp'],
];

const projects = [
  { name: 'SIMU-UNSAAC', tag: 'en desarrollo', text: 'Simulador del examen de admisión de la UNSAAC que armamos entre tres.', stack: 'Go · Gin · Next.js · Astro · MongoDB' },
  { name: 'Sistema de Gestión Comunal', text: 'Aporté en caja, registro de comuneros, eventos y métricas.', stack: 'Laravel 12' },
  { name: 'Red social universitaria', text: 'Proyecto del curso de Ingeniería de Software. Me tocó el módulo de publicaciones.', stack: 'React · Express · MariaDB' },
  { name: 'Ferretería y Control de Asistencias', text: 'Colaboré en el desarrollo de ambos sistemas; el detalle de mi parte te lo cuento en una entrevista.' },
  { name: 'Cursos de IA', text: 'Comparé redes para clasificar gestos de piedra, papel o tijera (MobileNetV2 ganó con 93,65 %) y probé un clasificador cuántico con Qiskit contra un SVM: 63 % contra 61 %. Interesante como experimento, nada más.', stack: 'Python · Qiskit' },
];

const mailIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6.5 8.5 7 8.5-7"/></svg>';
const phoneIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.5l1.8 4.6-2.3 1.4a11 11 0 0 0 6.5 6.5l1.4-2.3 4.6 1.8V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z"/></svg>';
const ghIcon = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jose Luis Quispe Tayña · Backend</title>
    <meta name="description" content="Jose Luis Quispe Tayña, desarrollador backend en Cusco. Egresado de Ingeniería Informática y de Sistemas (UNSAAC). Laravel, Next.js y sistemas reales en producción." />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content="Jose Luis Quispe Tayña · Backend" />
    <meta property="og:description" content="Desarrollador backend en Cusco. Lo que construí, los bugs que arreglé y cómo contactarme." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23141412'/%3E%3Cpath d='M8 11l5 5-5 5' fill='none' stroke='%239cc59a' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3Crect x='15' y='19' width='9' height='3' rx='1' fill='%239cc59a'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#ahora">Saltar al contenido</a>

    <div class="wrap">
      <header class="top">
        <span>luis tayña · cusco, perú</span>
        <nav aria-label="Secciones">
          <a href="#ahora">ahora</a>
          <a href="#antes">noretel</a>
          <a href="#bugs">bugs</a>
          <a href="#otros">otros</a>
          <a href="#contacto">contacto</a>
        </nav>
      </header>

      <section class="hero" aria-labelledby="name">
        <div>
          <pre class="ridge" aria-hidden="true">{ridge}</pre>
          <h1 id="name">Jose Luis<br />Quispe Tayña<span class="cursor" aria-hidden="true"></span></h1>
          <p class="lede">
            Hago backend con Laravel y Next.js. <span>Lo que más disfruto es entender por qué algo falla con datos reales y arreglarlo sin romper lo que ya funciona.</span>
          </p>
          <ul class="contact-row">
            <li><a class="primary" href={`mailto:${email}`}><Fragment set:html={mailIcon} />Escríbeme</a></li>
            <li><a href={`tel:+51${phone}`}><Fragment set:html={phoneIcon} />910 763 682</a></li>
            <li><a href="https://github.com/luisTayna" rel="me"><Fragment set:html={ghIcon} />luisTayna</a></li>
          </ul>
        </div>

        <figure class="log">
          <div class="log__cmd"><b>$</b> git log --oneline --author=luisTayna</div>
          <ol>
            {commits.map(([h, d, m], i) => (
              <li style={`--i:${i}`}><span class="h">{h}</span><span class="m">{m}</span></li>
            ))}
          </ol>
          <figcaption>Commits reales del CRM de NoreTel. El código es privado; los mensajes, no.</figcaption>
        </figure>
      </section>

      <main>
        <section class="section" id="ahora" aria-labelledby="t-ahora">
          <h2 id="t-ahora">En qué ando<small>2026 · autor principal</small></h2>
          <div class="body">
            <h3>Centro Electoral Cusco</h3>
            <p class="meta"><span class="live">en desarrollo</span> · 302 de 375 commits · repositorio privado</p>
            <p>
              Una plataforma para llevar el control de personeros, actas y resultados por región, provincia y distrito.
              Lo más entretenido ha sido el tema de permisos: un coordinador solo puede ver su territorio, y si algo no cuadra,
              el sistema no le muestra nada en vez de mostrarle todo.
            </p>
            <ul class="facts">
              <li>Roles por territorio; ante la duda, el acceso se cierra.</li>
              <li>Sesión con JWT en cookie HttpOnly.</li>
              <li>Historial de actas que no se edita: cada cambio queda como un registro nuevo.</li>
              <li>Más de 20 suites de pruebas de integración.</li>
            </ul>
            <p class="stack">Next.js 15 · TypeScript · PostgreSQL · Prisma</p>
          </div>
        </section>

        <section class="section" id="antes" aria-labelledby="t-antes">
          <h2 id="t-antes">Lo que hice antes<small>abr – set 2026 · prácticas</small></h2>
          <div class="body">
            <h3>NoreTel: los pagos por Yape que se revisaban a mano</h3>
            <p class="meta">CRM de un proveedor de internet · 642 horas · 94 de 134 commits</p>
            <p>
              Cuando llegué, cada pago por Yape se validaba a mano: alguien abría la captura que el cliente mandaba por WhatsApp
              y la comparaba con las notificaciones del celular de la empresa.
            </p>
            <p>
              Terminamos con una pasarela de WhatsApp, OCR para leer las capturas y una conciliación automática contra la
              notificación del banco. En agosto, los pagos por Yape ya se cerraban solos.
            </p>

            <figure class="diff" aria-label="Antes y después en el CRM">
              <figcaption class="diff__file">noretel-crm · antes → después</figcaption>
              <div class="diff__row del"><span class="s">-</span><span>pagos Yape cerrados automáticamente</span><span class="v">48 %</span></div>
              <div class="diff__row add"><span class="s">+</span><span>pagos Yape cerrados automáticamente</span><span class="v">100 %</span></div>
              <div class="diff__row del"><span class="s">-</span><span>consultas para mostrar 20 facturas</span><span class="v">601</span></div>
              <div class="diff__row add"><span class="s">+</span><span>consultas para mostrar 20 facturas</span><span class="v">3</span></div>
              <div class="diff__row del"><span class="s">-</span><span>pruebas automatizadas</span><span class="v">173</span></div>
              <div class="diff__row add"><span class="s">+</span><span>pruebas automatizadas</span><span class="v">230</span></div>
            </figure>

            <p>
              También me tocó una auditoría de seguridad y rendimiento con OWASP como guía: bloqueo de login por intentos,
              permisos en la consola de los routers, errores que ya no muestran detalles internos y una guarda para que
              el mismo mes no se facture dos veces.
            </p>

            <figure class="figure">
              <img src={`${base}anexos/conciliacion-yape.webp`} width="1400" height="868" loading="lazy" decoding="async" alt="Diagrama de secuencia: el cliente envía la captura por WhatsApp, el OCR extrae monto y código, y el CRM la concilia con la notificación del banco." />
              <figcaption>Cómo se concilia un pago, del informe final de prácticas.</figcaption>
            </figure>

            <p class="stack">Laravel 10 modular · MySQL · PHPUnit · WhatsApp (OpenWA) · OCR</p>
          </div>
        </section>

        <section class="section" id="bugs" aria-labelledby="t-bugs">
          <h2 id="t-bugs">Bugs que me enseñaron algo</h2>
          <div class="body">
            <ol class="bugs">
              <li>
                <h3>Clientes fantasma</h3>
                <p>WhatsApp empezó a mandar un identificador interno (LID) en lugar del número de teléfono, y el CRM lo guardaba como si fuera un celular. Desde ahí no confío en un dato externo sin verificar de dónde viene.</p>
              </li>
              <li>
                <h3>La factura que se cobraba dos veces</h3>
                <p>Un mes escrito como <code>01/08/2026 al 31/08/2026</code> y otro como <code>agosto 2026</code> eran, para el sistema, dos meses distintos. Lo resolví normalizando el periodo y validándolo dentro de la misma transacción que crea la factura.</p>
              </li>
              <li>
                <h3><code>Undefined constant "key"</code></h3>
                <p>Un gráfico mezclaba una variable de JavaScript dentro de una directiva de Blade. El reporte tiraba error 500 y nadie sabía por qué.</p>
              </li>
              <li>
                <h3>La terminal que cualquiera podía usar</h3>
                <p>La consola SSH de los routers solo pedía haber iniciado sesión. Ahora pide un permiso y deja registro de cada comando.</p>
                <p class="ref"><b>05c91e0</b> fix(network): restrict router SSH console to authorized users</p>
              </li>
            </ol>
          </div>
        </section>

        <section class="section" id="otros" aria-labelledby="t-otros">
          <h2 id="t-otros">Otras cosas en las que he trabajado<small>en equipo</small></h2>
          <div class="body">
            <ul class="projects">
              {projects.map((p) => (
                <li>
                  <span class="name">{p.name}{p.tag && <span>{p.tag}</span>}</span>
                  <p>{p.text}</p>
                  {p.stack && <p class="stack">{p.stack}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section" id="herramientas" aria-labelledby="t-herr">
          <h2 id="t-herr">Herramientas</h2>
          <div class="body">
            <dl class="tools">
              <div><dt>Uso a diario</dt><dd>Laravel, PHP, TypeScript, Next.js, MySQL, PostgreSQL, Git</dd></div>
              <div><dt>Las he usado en algo real</dt><dd>Prisma, Docker, NestJS, Python, Tailwind, PHPUnit</dd></div>
            </dl>
            <p class="stack">Me falta mucho por aprender, pero me gusta escribir la prueba antes que el arreglo.</p>
          </div>
        </section>

        <section class="section contact" id="contacto" aria-labelledby="t-contacto">
          <h2 id="t-contacto">Contacto</h2>
          <div class="body">
            <p>Si quieres conversar sobre algún proyecto o tienes una oportunidad, escríbeme.</p>
            <a class="big" href={`mailto:${email}`}>{email}</a>
            <ul class="contact-row">
              <li><a href={`tel:+51${phone}`}><Fragment set:html={phoneIcon} />910 763 682</a></li>
              <li><a href="https://github.com/luisTayna" rel="me"><Fragment set:html={ghIcon} />github.com/luisTayna</a></li>
            </ul>
          </div>
        </section>
      </main>

      <footer class="foot">
        <span>Jose Luis Quispe Tayña · Ingeniería Informática y de Sistemas, UNSAAC</span>
        <span>Hecho con Astro</span>
      </footer>
    </div>
  </body>
</html>
